{
  "name": "nuxt-chem-ui",
  "version": "0.1.0",
  "description": "Chemistry-focused UI components for Nuxt",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "module": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare playground",
    "build": "nuxt-module-build build",
    "build:playground": "nuxi build playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck playground",
    "prepare": "nuxt-module-build build --stub"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "kekule": "^1.0.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/cli": "^3.37.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "keywords": [
    "nuxt",
    "vue",
    "chemistry",
    "cheminformatics",
    "ui",
    "components"
  ]
}
